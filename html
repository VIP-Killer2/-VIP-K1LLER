<script>

const form = document.getElementById("form");

form.addEventListener("submit", async (e)=>{
e.preventDefault();

const f = e.target;

await fetch("/api/application",{
method:"POST",
headers:{"Content-Type":"application/json"},
body:JSON.stringify({
faction:f[0].value,
nick:f[1].value,
tg:f[2].value,
age:f[3].value
})
});

alert("Анкету відправлено");
form.reset();
});

// ===== АДМІН =====
function login(){
const pass = document.getElementById("pass").value;
if(pass==="1234"){
document.getElementById("admin").style.display="block";
loadApps();
}else{
alert("Невірний пароль");
}
}

async function loadApps(){
const res = await fetch("/api/applications");
const data = await res.json();

document.getElementById("apps").innerHTML =
data.map(a=>`
<div class="box">
<b>${a.nick}</b><br>
${a.faction} | ${a.age}
</div>
`).join("");
}

async function setLeader(){
await fetch("/api/set-leader",{
method:"POST",
headers:{"Content-Type":"application/json"},
body:JSON.stringify({
faction:document.getElementById("f").value,
name:document.getElementById("l").value
})
});
alert("OK");
}

async function addMember(){
await fetch("/api/add-member",{
method:"POST",
headers:{"Content-Type":"application/json"},
body:JSON.stringify({
faction:document.getElementById("f2").value,
player:document.getElementById("p").value
})
});
alert("OK");
}

</script>

