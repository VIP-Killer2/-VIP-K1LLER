const express = require("express");
const fs = require("fs");
const app = express();

app.use(express.json());
app.use(express.static("public"));

let DB = {
  applications: [],
  leaders: {},
  members: {}
};

function save(){
  fs.writeFileSync("db.json", JSON.stringify(DB, null, 2));
}

// ===== АНКЕТИ =====
app.post("/api/application", (req, res) => {
  DB.applications.push(req.body);
  save();
  res.send({ ok: true });
});

app.get("/api/applications", (req, res) => {
  res.send(DB.applications);
});

// ===== ЛІДЕРИ =====
app.post("/api/set-leader", (req, res) => {
  const { faction, name } = req.body;
  DB.leaders[faction] = name;
  save();
  res.send({ ok: true });
});

app.get("/api/leaders", (req, res) => {
  res.send(DB.leaders);
});

// ===== УЧАСНИКИ =====
app.post("/api/add-member", (req, res) => {
  const { faction, player } = req.body;

  if (!DB.members[faction]) DB.members[faction] = [];
  DB.members[faction].push(player);

  save();
  res.send({ ok: true });
});

app.get("/api/members", (req, res) => {
  res.send(DB.members);
});

// ===== ВСІ ДАНІ (для адмінки) =====
app.get("/api/data", (req, res) => {
  res.send(DB);
});

app.listen(3000, () => console.log("GTA_UKRAINE_RP SERVER ON 3000"));
